# Configuração por ambiente (12-factor). Copie para .env e ajuste.
EMPORIO_DB_PATH=data/emporio.duckdb
EMPORIO_RAW_DIR=data/raw
EMPORIO_CONTRACTS_DIR=data/contracts
EMPORIO_QUALITY_REPORT_PATH=data/quality_report.json
EMPORIO_REFERENCE_DATETIME=2026-03-25T10:00:00-04:00
EMPORIO_TIMEZONE=America/Campo_Grande

# --- LLM (qualquer provedor OpenAI-compatível; nada de modelo fixo no código) ---
# Padrão: Groq. Troque base URL e modelos para Ollama (local, sem chave) ou OpenAI.
EMPORIO_LLM_PROVIDER=openai_compatible   # ou "fake": determinístico, sem rede nem chave
EMPORIO_LLM_BASE_URL=https://api.groq.com/openai/v1
EMPORIO_LLM_API_KEY=
EMPORIO_LLM_MODEL_SMALL=openai/gpt-oss-20b     # roteador, guardas, resumo
EMPORIO_LLM_MODEL_MEDIUM=openai/gpt-oss-120b   # nó de resposta
# EMPORIO_LLM_MODEL_FALLBACK=                  # opcional: modelo reserva se o principal cair
# Ollama:  EMPORIO_LLM_BASE_URL=http://localhost:11434/v1  e modelos como qwen2.5:7b-instruct
# OpenAI:  EMPORIO_LLM_BASE_URL=https://api.openai.com/v1  e os modelos da sua conta
