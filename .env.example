# Configuração por ambiente (12-factor). Copie para .env e ajuste.
EMPORIO_DB_PATH=data/emporio.duckdb
EMPORIO_RAW_DIR=data/raw
EMPORIO_CONTRACTS_DIR=data/contracts
EMPORIO_QUALITY_REPORT_PATH=data/quality_report.json
EMPORIO_REFERENCE_DATETIME=2026-03-25T10:00:00-04:00
EMPORIO_TIMEZONE=America/Campo_Grande

# --- LLM (qualquer provedor; trocar é configuração, não código) ---
# Modelos aceitam spec "provedor:modelo"; sem prefixo vale EMPORIO_LLM_PROVIDER.
# Provedores: openai, azure_openai, anthropic, google, bedrock, groq, ollama, openrouter,
# deepseek, mistral, together, xai, vllm, openai_compatible (genérico) e fake (offline).
# Anthropic/Google/Bedrock exigem o extra: uv sync --extra anthropic|google|bedrock (ou all).
# Diagnóstico de todos os papéis (credencial + chamada real): make llm-check
EMPORIO_LLM_PROVIDER=openai_compatible   # ou "fake": determinístico, sem rede nem chave
EMPORIO_LLM_BASE_URL=https://api.groq.com/openai/v1   # endpoint do provedor padrão
EMPORIO_LLM_API_KEY=                                  # chave do provedor padrão
EMPORIO_LLM_MODEL_SMALL=openai/gpt-oss-20b     # roteador, guardas, resumo
EMPORIO_LLM_MODEL_MEDIUM=openai/gpt-oss-120b   # nó de resposta
# Cadeia de reserva (JSON), tentada em ordem; cada elo tem circuit breaker próprio:
# EMPORIO_LLM_FALLBACKS=["openai:gpt-5-mini","google:gemini-3.1-flash-lite"]
# Saída estruturada: auto (padrão do provedor) | function_calling | json_schema | json_mode
# EMPORIO_LLM_STRUCTURED_METHOD=auto
# EMPORIO_LLM_MODEL_FALLBACK=                  # legado: uma spec, anexada ao fim da cadeia
# Chave por provedor sem usar a variável do SDK (JSON):
# EMPORIO_LLM_API_KEYS={"anthropic":"...","google":"..."}
#
# Credenciais padrão de cada SDK (no ambiente do processo):
#   openai: OPENAI_API_KEY          anthropic: ANTHROPIC_API_KEY
#   google: GOOGLE_API_KEY ou GEMINI_API_KEY
#   azure_openai: AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT (+ OPENAI_API_VERSION)
#   bedrock: cadeia da AWS (AWS_ACCESS_KEY_ID/AWS_PROFILE/role IAM) + AWS_REGION
#   groq: GROQ_API_KEY  openrouter: OPENROUTER_API_KEY  deepseek: DEEPSEEK_API_KEY
#   mistral: MISTRAL_API_KEY  together: TOGETHER_API_KEY  xai: XAI_API_KEY
#   ollama/vllm: sem chave (local)
# EMPORIO_LLM_AZURE_API_VERSION=2024-10-21
# EMPORIO_LLM_AWS_REGION=us-east-1
#
# Exemplos (descomente um bloco):
# Anthropic:  EMPORIO_LLM_PROVIDER=anthropic
#             EMPORIO_LLM_MODEL_SMALL=claude-haiku-4-5
#             EMPORIO_LLM_MODEL_MEDIUM=claude-sonnet-5-5
# OpenAI:     EMPORIO_LLM_MODEL_SMALL=openai:gpt-5-mini  EMPORIO_LLM_MODEL_MEDIUM=openai:gpt-5
# Gemini:     EMPORIO_LLM_MODEL_SMALL=google:gemini-3.1-flash-lite
# Azure:      EMPORIO_LLM_MODEL_MEDIUM=azure_openai:<nome-do-deployment>
# Bedrock:    EMPORIO_LLM_MODEL_MEDIUM=bedrock:anthropic.claude-3-5-haiku-20241022-v1:0
#             (Llama: bedrock:meta.llama3-70b-instruct-v1:0; Mistral: bedrock:mistral.mistral-large-2402-v1:0)
# Groq:       EMPORIO_LLM_MODEL_SMALL=groq:openai/gpt-oss-20b
# OpenRouter: EMPORIO_LLM_MODEL_MEDIUM=openrouter:meta-llama/llama-3.3-70b-instruct
# DeepSeek:   EMPORIO_LLM_MODEL_MEDIUM=deepseek:deepseek-chat
# Mistral:    EMPORIO_LLM_MODEL_SMALL=mistral:mistral-small-latest
# Together:   EMPORIO_LLM_MODEL_MEDIUM=together:meta-llama/Llama-3.3-70B-Instruct-Turbo
# xAI:        EMPORIO_LLM_MODEL_MEDIUM=xai:grok-4
# Ollama:     EMPORIO_LLM_MODEL_SMALL=ollama:qwen2.5:7b-instruct   (http://localhost:11434/v1)
# vLLM:       EMPORIO_LLM_MODEL_MEDIUM=vllm:<modelo-servido>       (http://localhost:8000/v1)
# Misto:      roteador barato num provedor e resposta noutro:
#             EMPORIO_LLM_MODEL_SMALL=groq:openai/gpt-oss-20b
#             EMPORIO_LLM_MODEL_MEDIUM=anthropic:claude-sonnet-5-5

# --- Memória, relógio e limites ---
EMPORIO_CHECKPOINT_PATH=data/checkpoints.sqlite   # memória por sessão (LangGraph)
EMPORIO_TICKETS_PATH=data/tickets.sqlite          # chamados (somente anexação)
# Estado compartilhado entre réplicas (extras: `uv sync --extra postgres --extra redis`).
EMPORIO_STATE_BACKEND=sqlite                      # "postgres": checkpointer + chamados em Postgres (migrações no boot)
# EMPORIO_DATABASE_URL=postgresql://user:senha@host:5432/emporio   # obrigatório com state_backend=postgres
# EMPORIO_REDIS_URL=redis://host:6379/0           # presente: rate limit e tentativas de verificação no Redis
# Testes de integração (CI): EMPORIO_TEST_DATABASE_URL e EMPORIO_TEST_REDIS_URL; sem elas, são pulados.
EMPORIO_USE_SYSTEM_CLOCK=false                    # true: usa a data real em vez de 2026-03-25
EMPORIO_RATE_LIMIT_PER_MINUTE=20
EMPORIO_RATE_LIMIT_PER_IP_PER_MINUTE=60
EMPORIO_TRUSTED_PROXY_HOPS=0                      # N>0: IP do cliente = N-ésimo da direita em X-Forwarded-For

# --- Sessão e verificação (API) ---
# Segredo HMAC dos ids de sessão (>=16 bytes). Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Ausente: aleatório por processo (sessões morrem no restart; não use com várias réplicas).
EMPORIO_SESSION_SECRET=
EMPORIO_VERIFICATION_TTL_SECONDS=900              # validade da verificação do cliente na sessão
EMPORIO_VERIFY_MAX_ATTEMPTS_PER_TARGET=5          # falhas por pedido e por contato (entre sessões)
EMPORIO_VERIFY_MAX_ATTEMPTS_PER_IP=10
EMPORIO_VERIFY_LOCKOUT_SECONDS=900

# --- Canal WhatsApp (Meta Cloud API); desligado se TODAS ausentes, erro de boot se só algumas ---
# Webhook: https://<host>/webhooks/whatsapp (GET verifica, POST recebe, assinado por X-Hub-Signature-256).
# Operadores: /v1/operator/handoffs* com EMPORIO_OPERATOR_API_KEYS (JSON; != EMPORIO_API_KEYS).
# EMPORIO_WHATSAPP_VERIFY_TOKEN=          # string livre que você cadastra no painel da Meta
# EMPORIO_WHATSAPP_APP_SECRET=            # "App secret" do app Meta (valida a assinatura)
# EMPORIO_WHATSAPP_ACCESS_TOKEN=          # token permanente (System User) da Graph API
# EMPORIO_WHATSAPP_PHONE_NUMBER_ID=       # id do número (não é o telefone)
# EMPORIO_WHATSAPP_HASH_PEPPER=           # pepper do hash do telefone; estável e secreto
# EMPORIO_OPERATOR_API_KEYS=["ana:troque-por-token-longo","bia:outro-token-longo"]
# EMPORIO_WHATSAPP_API_VERSION=v21.0
# EMPORIO_WHATSAPP_RATE_LIMIT_PER_MINUTE=10
# EMPORIO_WHATSAPP_WORKERS=4                    # threads do canal; o resto do servidor não é afetado
# EMPORIO_WHATSAPP_QUEUE_SIZE=64               # além dos workers; excedente é descartado com log
# EMPORIO_WHATSAPP_HANDOFF_TTL_SECONDS=14400   # sem ação do operador, volta ao bot (premissa: 4h)
# EMPORIO_HANDOFF_PATH=data/handoff.sqlite     # sem EMPORIO_REDIS_URL; com Redis o handoff vai nele
