{"key": "c2c8dfb0f78afde0d5eafcb8", "prompt_hash": "6378cdad00be", "text": "Estamos localizados na Rua 14 de Maio, 3200, no Centro de Campo Grande.\n\nPosso te ajudar com mais alguma informação sobre nossos instrumentos?", "tool_calls": [], "usage": {"calls": 1, "cost_usd": 0.000257, "input_tokens": 1568, "output_tokens": 36}}
